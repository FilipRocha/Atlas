{
  "name": "atlas",
  "version": "3.4.0",
  "description": "A modern, open-source system cleaner for Windows, macOS, and Linux",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-hardware-bridge.js && node scripts/build-process-monitor.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run fetch:winget-bundle && electron-vite build && electron-builder",
    "package:win": "npm run fetch:winget-bundle && npm run build:hardware-bridge && npm run build:process-monitor && electron-vite build && electron-builder --win --publish never --config electron-builder.local.yml && node scripts/organize-windows-dist.js",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:all": "npm run fetch:winget-bundle && electron-vite build && electron-builder --win --mac --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:smoke": "node scripts/qa-runner.cjs",
    "qa:app-smoke": "node scripts/qa-app-smoke.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run validate:rules && npm test",
    "validate:rules": "npx tsx src/main/rules/validate.ts",
    "new-rule": "node scripts/new-rule.js",
    "find-cache": "node scripts/find-cache.js",
    "preview-rule": "node scripts/preview-rule.js",
    "parity-check": "node scripts/parity-check.js",
    "catalog": "node scripts/generate-catalog.js",
    "translate": "node scripts/translate.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "node scripts/release.js",
    "postinstall": "patch-package && electron-rebuild -w better-sqlite3",
    "dev:ui": "vite --config ui-preview.config.ts",
    "build:hardware-bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hardware-bridge.ps1",
    "build:process-monitor": "node scripts/build-process-monitor.js --required",
    "fetch:winget-bundle": "node scripts/fetch-winget-bundle.js"
  },
  "keywords": [
    "system-cleaner",
    "electron",
    "windows",
    "macos",
    "linux",
    "optimization"
  ],
  "author": {
    "name": "Atlas Contributors",
    "email": "atlas@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "conventional-changelog-angular": "^8.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "node-gyp": "^12.2.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@litko/yara-x": "^0.7.2",
    "@tanstack/react-table": "^9.2.4",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "framer-motion": "^13.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.577.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.3.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.13",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  }
}
